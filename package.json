{
  "name": "codex-chats-list",
  "displayName": "Codex Chats List",
  "version": "1.2.0",
  "private": true,
  "description": "Browse Codex conversations by project and continue in the official Codex sidebar.",
  "categories": [
    "AI",
    "Chat"
  ],
  "keywords": [
    "codex",
    "conversations",
    "cwd",
    "history",
    "projects"
  ],
  "homepage": "https://github.com/jaypume/vscode-codex-chats-list#readme",
  "bugs": {
    "url": "https://github.com/jaypume/vscode-codex-chats-list/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/jaypume/vscode-codex-chats-list.git"
  },
  "publisher": "pujie",
  "files": [
    "package.nls*.json",
    "dist/extension/**",
    "media/**",
    "README.md",
    "README.zh-CN.md",
    "CHANGELOG.md",
    "SUPPORT.md",
    "LICENSE"
  ],
  "main": "./dist/extension/extension.js",
  "scripts": {
    "build": "node scripts/build.mjs",
    "check": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "format": "oxfmt --write src/tree.ts src/time.ts package.json oxlint.config.mts .oxfmtrc.json vitest.config.mts",
    "format:check": "oxfmt --check src/tree.ts src/time.ts package.json oxlint.config.mts .oxfmtrc.json vitest.config.mts",
    "lint": "oxlint --max-warnings=0 src",
    "lint:fix": "pnpm run lint --fix",
    "package": "node -e \"require('node:fs').mkdirSync('release-artifact', { recursive: true })\" && vsce package --no-dependencies --out release-artifact",
    "release:check": "node scripts/check-release.mjs",
    "release:dry": "release-it --dry-run",
    "release:prepare": "release-it",
    "release:verify": "python3 scripts/marketplace.py",
    "test": "vitest run",
    "test:watch": "vitest",
    "vscode:prepublish": "pnpm run build"
  },
  "devDependencies": {
    "@release-it/bumper": "8.0.1",
    "@release-it/conventional-changelog": "12.0.2",
    "@types/node": "^22.0.0",
    "@types/vscode": "~1.100.0",
    "@vscode/vsce": "^3.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "release-it": "21.1.1",
    "typescript": "~5.9.0",
    "vitest": "5.0.5"
  },
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "codexProjectChats",
          "title": "%viewContainer.title%",
          "icon": "media/projects.svg"
        }
      ]
    },
    "views": {
      "codexProjectChats": [
        {
          "type": "tree",
          "id": "codexProjectChats.list",
          "name": "%view.title%",
          "contextualTitle": "Codex Chats List"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "codexProjectChats.list",
        "contents": "%welcome.noWorkspace%"
      }
    ],
    "commands": [
      {
        "command": "codexProjectChats.open",
        "title": "%command.open%",
        "category": "Codex Chats List"
      },
      {
        "command": "codexProjectChats.refresh",
        "title": "%command.refresh%",
        "category": "Codex Chats List",
        "icon": "$(refresh)"
      },
      {
        "command": "codexProjectChats.selectScope",
        "title": "%command.scope%",
        "category": "Codex Chats List",
        "icon": "$(filter)"
      },
      {
        "command": "codexProjectChats.search",
        "title": "%command.search%",
        "category": "Codex Chats List",
        "icon": "$(search)"
      },
      {
        "command": "codexProjectChats.clearSearch",
        "title": "%command.clearSearch%",
        "category": "Codex Chats List",
        "icon": "$(clear-all)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "codexProjectChats.selectScope",
          "when": "view == codexProjectChats.list",
          "group": "navigation@1"
        },
        {
          "command": "codexProjectChats.search",
          "when": "view == codexProjectChats.list",
          "group": "navigation@2"
        },
        {
          "command": "codexProjectChats.clearSearch",
          "when": "view == codexProjectChats.list && codexProjectChats.hasSearch",
          "group": "navigation@3"
        },
        {
          "command": "codexProjectChats.refresh",
          "when": "view == codexProjectChats.list",
          "group": "navigation@4"
        }
      ],
      "commandPalette": [
        {
          "command": "codexProjectChats.clearSearch",
          "when": "codexProjectChats.hasSearch"
        }
      ]
    },
    "configuration": {
      "title": "Codex Chats List",
      "properties": {
        "codexProjectChats.cliPath": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "%configuration.cliPath%"
        }
      }
    }
  },
  "activationEvents": [
    "onView:codexProjectChats.list"
  ],
  "extensionDependencies": [
    "openai.chatgpt"
  ],
  "extensionKind": [
    "workspace"
  ],
  "icon": "media/icon.png",
  "preview": false,
  "engines": {
    "node": "^24.15.0 || >=26.0.0",
    "vscode": "^1.100.0"
  },
  "packageManager": "pnpm@12.15.0",
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": false
    },
    "virtualWorkspaces": false
  }
}
